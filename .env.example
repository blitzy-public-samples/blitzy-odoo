# S3 Storage Backend Configuration for Odoo 19
# Copy this file to .env and customize for your environment.
# See odoo/addons/base/models/ir_attachment.py for implementation details.

# Storage backend selector: set to "s3" to enable S3 storage, leave empty/unset for filesystem (default)
IR_ATTACHMENT_STORAGE=s3

# S3 bucket name for storing attachments
AWS_S3_BUCKET=odoo-attachments

# Custom S3 endpoint URL (e.g., for LocalStack or MinIO in development)
# Leave empty or unset for real AWS S3 or when running tests with Moto
# IMPORTANT: Must be UNSET during tests to ensure Moto interception works correctly
AWS_ENDPOINT_URL=

# AWS credentials (use "test" for local development with Moto)
# In production, use real IAM credentials or instance role
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS region
AWS_DEFAULT_REGION=us-east-1
