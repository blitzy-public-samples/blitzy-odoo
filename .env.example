# S3 Storage Backend Configuration for Odoo Attachments
# Copy this file to .env and customize values for your environment.
# See also: docker-compose.yml for LocalStack startup

# Activates S3 backend when set to "s3". Unset or any other value
# preserves the default filesystem storage.
IR_ATTACHMENT_STORAGE=s3

# S3 bucket name for attachment storage.
AWS_S3_BUCKET=odoo-attachments

# S3-compatible endpoint URL. For LocalStack dev/test, use the default.
# In production with real AWS, leave unset to use the standard AWS endpoint.
AWS_ENDPOINT_URL=http://localhost:4566

# AWS credentials. For LocalStack, "test" is the default placeholder.
# In production, use real IAM credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS region for S3 operations.
AWS_DEFAULT_REGION=us-east-1
