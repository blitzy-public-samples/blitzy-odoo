# S3 storage backend — see IR_ATTACHMENT_STORAGE env var
# Copy this file to .env and adjust values for your environment.
# For production, unset AWS_ENDPOINT_URL to use real AWS.

# Activates S3 backend; unset or remove to preserve default filesystem behavior
IR_ATTACHMENT_STORAGE=s3

# Target S3 bucket for attachment storage
AWS_S3_BUCKET=odoo-attachments

# S3 endpoint override for LocalStack; unset in production to use real AWS
AWS_ENDPOINT_URL=http://localhost:4566

# S3 authentication credentials (use real AWS credentials in production)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 region configuration
AWS_DEFAULT_REGION=us-east-1
