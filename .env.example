# Document Sidecar Service Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the sidecar HTTP server (default: 3000)
PORT=3000

# Environment mode: development or production
# In development mode, pretty-printed logs are enabled
NODE_ENV=development

# =============================================================================
# Authentication
# =============================================================================

# API Key for authenticating requests (REQUIRED)
# Generate a secure random string for production use
API_KEY=your-api-key-here

# Secret key for HMAC-SHA256 request signature verification (REQUIRED)
# Generate a secure random string for production use
SECRET_KEY=your-hmac-secret-here

# =============================================================================
# Rate Limiting
# =============================================================================

# Maximum number of requests per time window (default: 100)
RATE_LIMIT_MAX=100

# Rate limit time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW=60000

# =============================================================================
# Logging
# =============================================================================

# Log level: trace, debug, info, warn, error (default: info)
LOG_LEVEL=info
