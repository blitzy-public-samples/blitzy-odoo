# =============================================================================
# Document Sidecar Service - Environment Configuration
# =============================================================================
#
# This file documents all environment variables for the TypeScript PDF
# rendering sidecar service. Copy this file to .env and configure the values
# for your environment.
#
# IMPORTANT: The API_KEY and SECRET_KEY values MUST match the corresponding
# Odoo configuration parameters (document_sidecar.api_key and
# document_sidecar.secret_key) for authentication to work properly.
#
# SECURITY NOTE: In production environments, use TLS (HTTPS) for all
# communication between Odoo and the sidecar service.
#
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the sidecar HTTP server
# Default: 3000
PORT=3000

# Environment mode: development or production
# - development: Enables pretty-printed logs via pino-pretty
# - production: Uses JSON structured logging for log aggregation
# Default: development
NODE_ENV=development

# =============================================================================
# Authentication (REQUIRED)
# =============================================================================

# API Key for authenticating requests from Odoo
# This key is sent via the X-API-Key header and validates client identity.
# REQUIRED: Generate a secure random string (minimum 32 characters recommended)
# Must match: Odoo ir.config_parameter 'document_sidecar.api_key'
API_KEY=your-api-key-here

# Secret key for HMAC-SHA256 request signature verification
# This key is used to compute the X-HMAC-Signature header to prevent tampering.
# REQUIRED: Generate a secure random string (minimum 32 characters recommended)
# Must match: Odoo ir.config_parameter 'document_sidecar.secret_key'
SECRET_KEY=your-hmac-secret-here

# =============================================================================
# Rate Limiting
# =============================================================================

# Maximum number of requests allowed per time window per API key
# Requests exceeding this limit receive HTTP 429 (Too Many Requests)
# Default: 100
RATE_LIMIT_MAX=100

# Rate limit time window in milliseconds
# Default: 60000 (1 minute)
# Example: 60000 = 100 requests per minute
RATE_LIMIT_WINDOW=60000

# =============================================================================
# Logging
# =============================================================================

# Log level controls logging verbosity
# Valid values (from most to least verbose):
#   - trace: All messages including detailed tracing
#   - debug: Debug information and above
#   - info:  Informational messages and above (recommended for production)
#   - warn:  Warnings and errors only
#   - error: Errors only
# Default: info
LOG_LEVEL=info
