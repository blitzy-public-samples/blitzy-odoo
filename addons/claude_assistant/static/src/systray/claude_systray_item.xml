<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="claude_assistant.SystrayItem">
        <t t-if="this.isInternal">
            <div class="o_claude_assistant_systray d-flex align-items-center">
                <button type="button" title="Claude Assistant" aria-label="Claude Assistant"
                        t-on-click="() => this.toggle()">
                    <i class="fa fa-comments" role="img" aria-label="Claude Assistant"/>
                </button>
                <ClaudeAssistantPanel t-if="state.open" close="() => this.toggle()"/>
            </div>
        </t>
    </t>

</templates>
