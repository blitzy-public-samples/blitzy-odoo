{
  "name": "document-sidecar",
  "version": "1.0.0",
  "description": "TypeScript sidecar service for PDF document generation extracted from Odoo",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/rate-limit": "^9.1.0",
    "puppeteer": "^23.6.0",
    "handlebars": "^4.7.8",
    "zod": "^3.23.8",
    "pdf-lib": "^1.17.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.6",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2",
    "tsx": "^4.19.1",
    "pino-pretty": "^11.2.2"
  },
  "keywords": [
    "pdf",
    "document",
    "sidecar",
    "odoo",
    "puppeteer",
    "fastify"
  ],
  "license": "LGPL-3.0"
}
